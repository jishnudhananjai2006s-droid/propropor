# Copy these into Replit "Secrets" (padlock icon). Never commit real values.

# demo = simulated payments for testing (nobody is charged). Then switch to stripe or razorpay.
PAYMENTS_PROVIDER=demo

# Long random text. Signs the "Pro" token stored on each device. Required before going live.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# Shown on the paywall. Free trial length in days (0 = no trial).
PRICE_LABEL=₹149 / month
TRIAL_DAYS=7

# Your public site address, if the automatic one is wrong (no trailing slash).
# PUBLIC_URL=https://your-app.replit.app

# AI race planner (Pro only). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=
# AI_DAILY_LIMIT=20
# AI_GLOBAL_DAILY_LIMIT=500

# --- Stripe (PAYMENTS_PROVIDER=stripe) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...

# --- Razorpay (PAYMENTS_PROVIDER=razorpay) ---
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_PLAN_ID=plan_...
# RAZORPAY_TOTAL_COUNT=120

# Sign-in. Leave empty for test sign-in (no Google needed, not allowed with live payments).
GOOGLE_CLIENT_ID=
